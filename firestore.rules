rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // Any Firebase sign-in, verified or not. Only registration and reading
    // your own profile use this directly: registration writes the profile
    // before the verification link is clicked, and the app reads its own
    // profile to tell a deactivated user why they can't log in.
    function authed() {
      return request.auth != null;
    }

    // A verified account that hasn't been deactivated. The app already
    // refuses both at login, but that alone doesn't stop anyone calling
    // Firestore directly — this does. Every role check below builds on it.
    function signedIn() {
      return authed()
        && request.auth.token.email_verified == true
        && (
          !exists(userPath(request.auth.uid))
          || get(userPath(request.auth.uid)).data.get('status', 'Active')
            != 'Archived'
        );
    }

    function userExists() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function currentUser() {
      return get(userPath(request.auth.uid)).data;
    }

    function currentRole() {
      return currentUser().role;
    }

    function currentName() {
      return currentUser().name;
    }

    function isAdmin() {
      return userExists() && currentRole() == 'Admin';
    }

    function isHead() {
      return userExists() && currentRole() == 'Head';
    }

    function isSupervisor() {
      return userExists() && currentRole() == 'Supervisor';
    }

    function isStudentAssistant() {
      return userExists() && currentRole() == 'Student Assistant';
    }

    // Whether the account [uid] (not the requester) is a Head or Supervisor.
    function isStaffAccount(uid) {
      let profile = /databases/$(database)/documents/users/$(uid);
      return uid is string && uid != '' && exists(profile)
        ? get(profile).data.get('role', '') in ['Head', 'Supervisor']
        : false;
    }

    // Head + Supervisor: the operational staff roles that manage students,
    // tasks, announcements, attendance, and schedules day-to-day. Admin no
    // longer touches this data — Admin is scoped to Accounts, Departments,
    // and Settings only.
    function isStaff() {
      return isHead() || isSupervisor();
    }

    // ── Supervisor office scope ─────────────────────────────────────────
    // A Supervisor may only change records for student assistants in an
    // active office they head. The office document is the authority (only
    // the Head can edit offices); officeAssignments/{uid}, kept in step by
    // the Head's session, just says which office to look in.
    //
    // These use `cond ? a : b` rather than `cond && a` to skip work: when
    // the condition reads a document, Firestore evaluates both sides of an
    // && anyway, and that is enough to hit its 1,000-expression limit on a
    // task edit.

    function officeHeadsStudent(office, studentUid) {
      return office.get('isActive', true) == true
        && request.auth.uid in office.get('headIds', [])
        && studentUid in office.get('assistantIds', []);
    }

    function assignedOfficeHeadsStudent(officeId, studentUid) {
      let office = /databases/$(database)/documents/offices/$(officeId);
      return officeId is string && officeId != '' && exists(office)
        ? officeHeadsStudent(get(office).data, studentUid)
        : false;
    }

    function officeOfStudentHeaded(studentUid) {
      let assignment =
        /databases/$(database)/documents/officeAssignments/$(studentUid);
      return exists(assignment)
        ? assignedOfficeHeadsStudent(
          get(assignment).data.get('officeId', ''),
          studentUid
        )
        : false;
    }

    // [studentUid] is the student's account id, as attendance and reports
    // store it.
    function isSupervisorOf(studentUid) {
      return studentUid is string && studentUid != '' && isSupervisor()
        ? officeOfStudentHeaded(studentUid)
        : false;
    }

    function isSupervisorOfRosterEntry(rosterId) {
      let entry = /databases/$(database)/documents/students/$(rosterId);
      return exists(entry)
        ? isSupervisorOf(get(entry).data.get('userId', ''))
        : false;
    }

    // Tasks, evaluations and class schedules name their student by roster
    // id. That is normally the account id itself; older roster entries keep
    // the account id in `userId` instead.
    function isSupervisorOfStudent(studentRef) {
      return studentRef is string && studentRef != ''
        ? (
          isSupervisorOf(studentRef)
            ? true
            : isSupervisorOfRosterEntry(studentRef)
        )
        : false;
    }

    // ── Field helpers ───────────────────────────────────────────────────

    // Whether [field] is the same before and after this write, treating a
    // missing field as [fallback] on both sides.
    function sameOr(field, fallback) {
      return request.resource.data.get(field, fallback)
        == resource.data.get(field, fallback);
    }

    function unchanged(field) {
      return sameOr(field, null);
    }

    // "Sep 3, 2026" — the Philippine calendar date [days] days from now, in
    // the shape the app stamps on completed tasks.
    function phDate(days) {
      let t = request.time + duration.value(8 + days * 24, 'h');
      let months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug',
        'Sep', 'Oct', 'Nov', 'Dec'];
      return months[t.month() - 1] + ' ' + string(t.day()) + ', '
        + string(t.year());
    }

    match /users/{uid} {
      // Head and Supervisor need to read user/student profiles for
      // Students, Reports, Attendance, Tasks, and office matching. Admin
      // needs read access here to manage Accounts.
      allow read: if isAdmin() || isStaff()
        || (authed() && request.auth.uid == uid);

      // The Admin creates accounts of any role (Accounts screen). Anyone
      // else only registers themselves, and a self-made profile is always
      // an active Student with no SA ID, under the email the account
      // actually signed up with.
      allow create: if isAdmin()
        || (
          authed()
          && request.auth.uid == uid
          && request.resource.data.role == 'Student'
          && request.resource.data.get('status', 'Active') == 'Active'
          && request.resource.data.get('saId', null) == null
          && request.resource.data.email.lower()
            == request.auth.token.email.lower()
        );

      // Role/status changes (Accounts screen) stay Admin-only, with two
      // Head exceptions: approving an application (Applications screen)
      // promotes the applicant from Student to Student Assistant and records
      // their SA ID and skills, and a rehire decision (Rehiring screen)
      // either keeps a Student Assistant on or returns them to Student. A
      // Head may only move a profile between those two roles, and may not
      // change status or email.
      //
      // Users editing their own profile may change their contact details,
      // photo, skills and year level — never their name, email, IDs or
      // department. Names matter: payroll and several screens match records
      // to people by name, so a self-chosen name could claim someone
      // else's records.
      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == uid
          && unchanged('role')
          && unchanged('status')
          && unchanged('name')
          && unchanged('email')
          && unchanged('studentId')
          && unchanged('saId')
          && unchanged('department')
          && unchanged('campus')
          && unchanged('courseProgram')
        )
        || (
          isHead()
          && resource.data.role in ['Student', 'Student Assistant']
          && request.resource.data.role in ['Student', 'Student Assistant']
          && request.resource.data.status == resource.data.status
          && request.resource.data.email == resource.data.email
        );

      allow delete: if isAdmin();
    }

    match /students/{id} {
      // Admin reads these too now, to match Payroll records to students
      // whose account name and roster name differ.
      allow read: if isStaff() || isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      // Roster records change when the Head approves, rehires or releases
      // a student assistant. Supervisors never edit the roster.
      allow create, update, delete: if isHead();
    }

    match /announcements/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    // Applications & Applicant Screening are Head-exclusive now.
    match /applications/{id} {
      allow read: if isHead()
        || (
          signedIn()
          && resource.data.applicantId == request.auth.uid
        );

      // A new application is always Pending, under the applicant's own
      // name. Only the Head decides it.
      allow create: if signedIn()
        && request.resource.data.applicantId == request.auth.uid
        && request.resource.data.get('status', 'Pending') == 'Pending'
        && request.resource.data.get('remarks', null) == null
        && request.resource.data.applicantName == currentName()
        && applicationsOpen();

      // The Admin's "Open Applications" setting for the academic year. Like
      // the app, a setting that was never saved counts as open.
      function applicationsOpen() {
        let settings =
          /databases/$(database)/documents/meta/academic_year_settings;
        return exists(settings)
          ? get(settings).data.get('allowApplications', true) == true
          : true;
      }

      allow update, delete: if isHead();
    }

    // Reports feed the Supervisor's DTR/Accomplishment Report approval flow.
    // Head still reads all reports (used for org-wide hours totals) but
    // doesn't approve/edit/delete individual reports through the UI.
    match /reports/{id} {
      // Admin reads these too now, to verify accomplishment reports before
      // processing Payroll.
      allow read: if isHead() || isSupervisor() || isAdmin()
        || (
          signedIn()
          && resource.data.applicantId == request.auth.uid
        );

      // A report arrives Pending, under its author's own name, with nothing
      // a supervisor adds. Payroll treats an Approved report as sign-off, so
      // only the student's supervisor may approve it.
      allow create: if signedIn()
        && request.resource.data.applicantId == request.auth.uid
        && request.resource.data.status == 'Pending'
        && request.resource.data.studentName == currentName()
        && request.resource.data.get('feedback', null) == null
        && request.resource.data.get('sentToHead', false) == false
        && request.resource.data.get('sentToHeadAt', null) == null
        && request.resource.data.get('headAttachments', []).size() == 0;

      allow update: if isSupervisorOf(resource.data.applicantId)
        && unchanged('applicantId');

      allow delete: if isSupervisorOf(resource.data.applicantId);
    }

    match /attendance/{id} {
      // Admin reads these too now, to retrieve and verify DTR records
      // before processing Payroll.
      allow read: if isStaff() || isAdmin()
        || (
          signedIn()
          && resource.data.studentId == request.auth.uid
        );

      // Students never write here. They clock in and out through the
      // clock-attendance Supabase Edge Function, which validates the scanned
      // QR against the current session on the server and writes with a
      // Firebase service account. Leaving this staff-only is what stops a
      // student from calling the API directly and forging their own hours.
      // A Supervisor is further limited to their own office's students.
      allow create: if isHead()
        || isSupervisorOf(request.resource.data.studentId);

      allow update: if isHead()
        || (
          isSupervisorOf(resource.data.studentId)
          && unchanged('studentId')
        );

      allow delete: if isHead() || isSupervisorOf(resource.data.studentId);
    }

    match /tasks/{id} {
      allow read: if isStaff()
        || (
          signedIn()
          && (
            resource.data.assignedTo == request.auth.uid
            || (
              resource.data.assignedTo != null
              && exists(
                /databases/$(database)/documents/students/$(resource.data.assignedTo)
              )
              && get(
                /databases/$(database)/documents/students/$(resource.data.assignedTo)
              ).data.userId == request.auth.uid
            )
          )
        );

      // A Supervisor may create, change or remove tasks for their own
      // office's students (or tasks not assigned to anyone yet).
      function supervisorMayHandle(task) {
        return task.get('assignedTo', null) == null
          ? isSupervisor()
          : isSupervisorOfStudent(task.assignedTo);
      }

      allow create: if isHead()
        || supervisorMayHandle(request.resource.data);

      // Ternaries, not ||, so only the requester's own case is evaluated —
      // see "Supervisor office scope" above.
      allow update: if isHead()
        ? true
        : (
          isSupervisor()
            ? supervisorMayHandle(resource.data)
              && supervisorMayHandle(request.resource.data)
            : (
              signedIn() && resource.data.assignedTo == request.auth.uid
                ? studentTaskUpdate()
                : false
            )
        );

      allow delete: if isHead()
        || supervisorMayHandle(resource.data);

      // The student a task is assigned to may only move it through its
      // statuses. The completion date feeds their DTR, so it can only be
      // set to today (a day's slack either way for clocks and midnight).
      // Defaults mirror Task.fromJson, so older documents missing a field
      // still compare equal after the app rewrites them.
      function studentTaskUpdate() {
        return request.resource.data.get('status', '')
            in ['Not Started', 'In Progress', 'Completed']
          && sameOr('title', '')
          && sameOr('description', '')
          && sameOr('priority', 'Medium')
          && sameOr('dueDate', '')
          && unchanged('assignedTo')
          && unchanged('assignedToName')
          && unchanged('assignedBy')
          && unchanged('category')
          && sameOr('checklistItems', [])
          && sameOr('isArchived', false)
          && unchanged('academicYear')
          && (
            unchanged('completedAt')
            || request.resource.data.get('completedAt', null) == null
            || (
              request.resource.data.status == 'Completed'
              && request.resource.data.completedAt
                in [phDate(-1), phDate(0), phDate(1)]
            )
          );
      }
    }

    match /classSchedules/{id} {
      allow read: if isStaff()
        || (
          signedIn()
          && resource.data.studentId == request.auth.uid
        );

      allow create: if isHead()
        || isSupervisorOfStudent(request.resource.data.studentId);

      allow update: if isHead()
        || (
          isSupervisorOfStudent(resource.data.studentId)
          && unchanged('studentId')
        );

      allow delete: if isHead()
        || isSupervisorOfStudent(resource.data.studentId);
    }

    // Notifications: Head owns the admin_notifications feed, Supervisor
    // owns sa_notifications. Deletion (feed management) is Head-only now.
    match /notifications/{id} {
      allow read: if isStaff()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      // Staff and the Admin (payroll, role changes) may notify anyone.
      // Anyone else may notify themselves, or send the Head or a Supervisor
      // one of the alerts the app raises for them — a new application, a
      // new report, a task's status changing — as plain text, with no
      // attachment link to lure them to.
      allow create: if isStaff() || isAdmin()
        || (
          signedIn()
          && request.resource.data.userId == request.auth.uid
        )
        || (
          signedIn()
          && request.resource.data.type in ['application', 'report', 'task']
          && request.resource.data.get('attachmentUrl', null) == null
          && request.resource.data.get('attachmentName', null) == null
          && request.resource.data.get('isRead', false) == false
          && isStaffAccount(request.resource.data.userId)
        );

      allow update: if isStaff()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      allow delete: if isHead()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );
    }

    // Offices decide which students each Supervisor may change, so only the
    // Head (who runs the Offices screen) edits them.
    match /offices/{id} {
      allow read: if signedIn();
      allow write: if isHead();
    }

    // Which office each student assistant is in, mirrored from the offices
    // by the Head's session so the rules above can find it.
    match /officeAssignments/{uid} {
      allow read, write: if isHead();
    }

    // Departments & Settings stay Admin-exclusive.
    match /departments/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Skills screen is Head-exclusive now.
    match /skills/{id} {
      allow read: if signedIn();
      allow write: if isHead();
    }

    // Performance Evaluation screen is Supervisor-exclusive. The Head reads
    // evaluations for the Rehiring screen, which follows up on each one's
    // "Eligible for Rehire" mark, but never edits them.
    match /evaluations/{id} {
      allow read: if isSupervisor() || isHead();

      allow create: if isSupervisorOfStudent(request.resource.data.studentId);

      allow update: if isSupervisorOfStudent(resource.data.studentId)
        && unchanged('studentId');

      allow delete: if isSupervisorOfStudent(resource.data.studentId);
    }

    // The Head's rehire decisions, one per student per term.
    match /rehireRecords/{id} {
      allow read, write: if isHead();
    }

    // Items a Supervisor forwards to the Head (reports, evaluations, DTR
    // reports) for the Head's dedicated "Sent to Head" screen. Supervisor
    // creates them; Head can read and toggle "reviewed".
    match /headForwards/{id} {
      allow read: if isHead() || isSupervisor();
      allow create: if isSupervisor();
      allow update: if isHead()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewed']);
      allow delete: if isHead();
    }

    // Payroll: an Admin initiates processing; each record is also readable
    // by the Student Assistant it was paid to.
    match /payrollRecords/{id} {
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.studentId == request.auth.uid
        );
      allow create, update, delete: if isAdmin();
    }

    // The Admin's editable copy of the printed Hourly Wage Payroll.
    match /payrollSheets/{id} {
      allow read, write: if isAdmin();
    }

    // Applicant Screening is Head-exclusive.
    match /screeningRecords/{id} {
      allow read, write: if isHead();
    }

    match /documents/{id} {
      allow read, write: if isStaff();
    }

    // Document Folders is the Head's free-form file manager for uploads
    // that aren't tied to an application/report/evaluation.
    match /documentFolders/{id} {
      allow read, write: if isHead();
    }

    // ── Schedules ───────────────────────────────────────────────────────
    // Weekly schedules and calendar events say where someone is and when.
    // Each belongs to one account (ownerId). The Head, the owner, and the
    // Supervisor of the owner's office may see and change it — the owner
    // only if they are a Student Assistant or Supervisor, the roles with a
    // Schedule screen. Schedules saved before accounts were recorded have
    // no ownerId and stay Head-only until the Head's session moves them
    // across.

    function maySeeSchedule(ownerId) {
      return isHead()
        || (signedIn() && ownerId != '' && ownerId == request.auth.uid)
        || isSupervisorOf(ownerId);
    }

    function mayChangeSchedule(ownerId) {
      return isHead()
        || (
          ownerId != ''
          && ownerId == request.auth.uid
          && (isStudentAssistant() || isSupervisor())
        )
        || isSupervisorOf(ownerId);
    }

    // One document per owner, keyed by their account id.
    match /recurringSchedules/{ownerId} {
      allow read: if maySeeSchedule(ownerId);
      allow create, update: if mayChangeSchedule(ownerId)
        && request.resource.data.get('ownerId', '') == ownerId;
      allow delete: if mayChangeSchedule(ownerId);
    }

    match /schedule_events/{id} {
      allow read: if maySeeSchedule(resource.data.get('ownerId', ''));
      allow create: if mayChangeSchedule(
        request.resource.data.get('ownerId', '')
      );
      allow update: if mayChangeSchedule(resource.data.get('ownerId', ''))
        && mayChangeSchedule(request.resource.data.get('ownerId', ''));
      allow delete: if mayChangeSchedule(resource.data.get('ownerId', ''));
    }

    // The session's attendance code. Only the staff who post it may read
    // it: anyone else who could read it could clock in without being there.
    // Students' scans are checked against it on the server, by the
    // clock-attendance function, which reads it with its own access.
    match /meta/current_qr {
      allow read, write: if isStaff();
    }

    match /meta/academic_year_settings {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Every other meta document. Firestore allows a request if any matching
    // rule does, and this one matches the documents above too — so it must
    // leave them out: its read would hand everyone the attendance code, and
    // its staff write would let a Head or Supervisor change Admin-only
    // settings.
    match /meta/{document} {
      allow read: if signedIn() && document != 'current_qr';
      allow write: if isStaff() && document != 'academic_year_settings';
    }

    // Finished academic years: one summary per year, which the Reports
    // screen offers everyone as a filter. The Admin records a year when
    // moving the settings on; the Head's session records one whose end date
    // has passed and copies each year's records into it — only the Head can
    // read them all.
    match /meta/academic_year_archives/years/{year} {
      allow read: if signedIn();
      allow write: if isAdmin() || isHead();
    }

    match /meta/academic_year_archives/years/{year}/{collection}/{id} {
      allow read: if isHead() || isAdmin();
      allow write: if isHead();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
