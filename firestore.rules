rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // Any Firebase sign-in, verified or not. Only registration and reading
    // your own profile use this directly: registration writes the profile
    // before the verification link is clicked, and the app reads its own
    // profile to tell a deactivated user why they can't log in.
    function authed() {
      return request.auth != null;
    }

    // A verified account that hasn't been deactivated. The app already
    // refuses both at login, but that alone doesn't stop anyone calling
    // Firestore directly — this does. Every role check below builds on it.
    //
    // A staff sign-up waiting for the Head ('Pending'), or one the Head
    // turned down ('Declined'), has no access either: until it is approved it
    // is a powerless Student profile with a `requestedRole` and nothing more.
    function signedIn() {
      return authed()
        && request.auth.token.email_verified == true
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.get('deleted', false) == false
        && !(get(userPath(request.auth.uid)).data.get('status', 'Active')
          in ['Archived', 'Pending', 'Declined']);
    }

    function userExists() {
      return signedIn();
    }

    function currentUser() {
      return get(userPath(request.auth.uid)).data;
    }

    function currentRole() {
      return currentUser().role;
    }

    function currentName() {
      return currentUser().name;
    }

    function isAdmin() {
      return userExists() && currentRole() == 'Admin';
    }

    function isHead() {
      return userExists() && currentRole() == 'Head';
    }

    function isSupervisor() {
      return userExists() && currentRole() == 'Supervisor';
    }

    function isStudentAssistant() {
      return userExists() && currentRole() == 'Student Assistant';
    }

    // Whether the account [uid] (not the requester) is a Head or Supervisor.
    function isStaffAccount(uid) {
      let profile = /databases/$(database)/documents/users/$(uid);
      return uid is string && uid != '' && exists(profile)
        ? get(profile).data.get('role', '') in ['Head', 'Supervisor']
        : false;
    }

    // Head + Supervisor: the operational staff roles that manage students,
    // tasks, announcements, attendance, and schedules day-to-day. Admin no
    // longer touches this data — Admin is scoped to Accounts, Departments,
    // and Settings only.
    function isStaff() {
      return isHead() || isSupervisor();
    }

    // ── Supervisor office scope ─────────────────────────────────────────
    // A Supervisor may only change records for student assistants in an
    // active office they head. The office document is the authority (only
    // the Head can edit offices); officeAssignments/{uid}, kept in step by
    // the Head's session, just says which office to look in.
    //
    // These use `cond ? a : b` rather than `cond && a` to skip work: when
    // the condition reads a document, Firestore evaluates both sides of an
    // && anyway, and that is enough to hit its 1,000-expression limit on a
    // task edit.

    function officeHeadsStudent(office, studentUid) {
      return office.get('isActive', true) == true
        && request.auth.uid in office.get('headIds', [])
        && studentUid in office.get('assistantIds', []);
    }

    function assignedOfficeHeadsStudent(officeId, studentUid) {
      let office = /databases/$(database)/documents/offices/$(officeId);
      return officeId is string && officeId != '' && exists(office)
        ? officeHeadsStudent(get(office).data, studentUid)
        : false;
    }

    function officeOfStudentHeaded(studentUid) {
      let assignment =
        /databases/$(database)/documents/officeAssignments/$(studentUid);
      return exists(assignment)
        ? assignedOfficeHeadsStudent(
          get(assignment).data.get('officeId', ''),
          studentUid
        )
        : false;
    }

    // [studentUid] is the student's account id, as attendance and reports
    // store it.
    function isSupervisorOf(studentUid) {
      return studentUid is string && studentUid != '' && isSupervisor()
        ? officeOfStudentHeaded(studentUid)
        : false;
    }

    function isSupervisorOfRosterEntry(rosterId) {
      let entry = /databases/$(database)/documents/students/$(rosterId);
      return exists(entry)
        ? isSupervisorOf(get(entry).data.get('userId', ''))
        : false;
    }

    // Tasks, evaluations and class schedules name their student by roster
    // id. That is normally the account id itself; older roster entries keep
    // the account id in `userId` instead.
    function isSupervisorOfStudent(studentRef) {
      return studentRef is string && studentRef != ''
        ? (
          isSupervisorOf(studentRef)
            ? true
            : isSupervisorOfRosterEntry(studentRef)
        )
        : false;
    }

    // Whether the signed-in Supervisor heads the active office [officeId]
    // (by account id, as the office document lists it).
    function supervisorHeadsOffice(officeId) {
      let office = /databases/$(database)/documents/offices/$(officeId);
      return isSupervisor() && exists(office)
        ? get(office).data.get('isActive', true) == true
          && request.auth.uid in get(office).data.get('headIds', [])
        : false;
    }

    // ── Field helpers ───────────────────────────────────────────────────

    // Whether [field] is the same before and after this write, treating a
    // missing field as [fallback] on both sides.
    function sameOr(field, fallback) {
      return request.resource.data.get(field, fallback)
        == resource.data.get(field, fallback);
    }

    function unchanged(field) {
      return sameOr(field, null);
    }

    // The Head's session moving a record made under an academic year the
    // Admin then undid back to the restored year: nothing else changes.
    function headMovesAcademicYear() {
      return isHead()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['academicYear']);
    }

    // "Sep 3, 2026" — the Philippine calendar date [days] days from now, in
    // the shape the app stamps on completed tasks.
    function phDate(days) {
      let t = request.time + duration.value(8 + days * 24, 'h');
      let months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug',
        'Sep', 'Oct', 'Nov', 'Dec'];
      return months[t.month() - 1] + ' ' + string(t.day()) + ', '
        + string(t.year());
    }

    // "20260903" — the same Philippine calendar date, as part of a
    // document id.
    function phDayKey() {
      let t = request.time + duration.value(8, 'h');
      return string(t.year())
        + (t.month() < 10 ? '0' : '') + string(t.month())
        + (t.day() < 10 ? '0' : '') + string(t.day());
    }

    // The Privacy Notice acceptance recorded at registration: when and which
    // version, both text and short, or absent (older accounts, or one an
    // Admin made).
    function validConsent(data) {
      let at = data.get('consentAt', null);
      let version = data.get('consentVersion', null);
      return (at == null || (at is string && at.size() <= 40))
        && (version == null || (version is string && version.size() <= 40));
    }

    // Whether they also get notifications by email: true, false or absent
    // (absent counts as on). Only the person changes it.
    function validEmailPref(data) {
      let pref = data.get('emailNotifications', null);
      return pref == null || pref is bool;
    }

    // A person registering themselves must have accepted it.
    function acceptedNotice(data) {
      return data.get('consentAt', null) is string
        && data.get('consentVersion', null) is string
        && validConsent(data);
    }

    match /users/{uid} {
      // Head and Supervisor need to read user/student profiles for
      // Students, Reports, Attendance, Tasks, and office matching. Admin
      // needs read access here to manage Accounts.
      allow read: if isAdmin() || isStaff()
        || (authed() && request.auth.uid == uid);

      // The Admin creates accounts of any role (Accounts screen). Anyone
      // else only registers themselves, and a self-made profile is always
      // a Student with no SA ID, under the email the account actually signed
      // up with. It is Active, or — for a staff sign-up — Pending with the
      // Supervisor or Head role it asks for in `requestedRole`; the Head
      // then approves it (below). It never carries the staff role itself.
      allow create: if isAdmin()
        || (
          authed()
          && request.auth.uid == uid
          && request.resource.data.role == 'Student'
          && (
            (
              request.resource.data.get('status', 'Active') == 'Active'
              && request.resource.data.get('requestedRole', null) == null
            )
            || (
              request.resource.data.get('status', 'Active') == 'Pending'
              && request.resource.data.get('requestedRole', '')
                in ['Supervisor', 'Head']
            )
          )
          && request.resource.data.get('saId', null) == null
          && request.resource.data.get('acceptedAt', null) == null
          && request.resource.data.get('studentIdVerifiedAt', null) == null
          && request.resource.data.get('studentIdVerifiedBy', null) == null
          && request.resource.data.get('deleted', false) == false
          && request.resource.data.email.lower()
            == request.auth.token.email.lower()
          && acceptedNotice(request.resource.data)
          && validEmailPref(request.resource.data)
        );

      // Role/status changes (Accounts screen) stay Admin-only, with three
      // Head exceptions: approving an application (Applications screen)
      // promotes the applicant from Student to Student Assistant and records
      // their SA ID and skills, a rehire decision (Rehiring screen) either
      // keeps a Student Assistant on or returns them to Student, and
      // archiving or restoring a student (Students screen) deactivates or
      // reactivates their sign-in. A Head may only move a profile between
      // those two roles and between Active and Archived, may not change its
      // email, and may not touch a deleted account.
      //
      // Users editing their own profile may change their contact details,
      // photo, skills and year level — never their name (or its parts),
      // email, IDs or department. Names matter: payroll and several screens
      // match records to people by name, so a self-chosen name could claim
      // someone else's records, and the payroll prints the name's parts.
      //
      // The day someone was accepted as a Student Assistant (`acceptedAt`)
      // is the Head's or the Admin's to record, never the person's own.
      //
      // Only the Admin deletes accounts, which marks them `deleted`.
      // Nobody (the Admin and the Head included) rewrites the record of
      // when someone accepted the Privacy Notice.
      allow update: if (isAdmin() && unchanged('consentAt')
          && unchanged('consentVersion') && unchanged('emailNotifications'))
        || (
          signedIn()
          && request.auth.uid == uid
          && unchanged('role')
          && unchanged('status')
          && unchanged('requestedRole')
          && unchanged('name')
          && unchanged('firstName')
          && unchanged('middleName')
          && unchanged('lastName')
          && unchanged('suffix')
          && unchanged('email')
          && unchanged('studentId')
          && unchanged('studentIdVerifiedAt')
          && unchanged('studentIdVerifiedBy')
          && unchanged('saId')
          && unchanged('acceptedAt')
          && unchanged('consentAt')
          && unchanged('consentVersion')
          && unchanged('department')
          && unchanged('campus')
          && unchanged('courseProgram')
          && sameOr('deleted', false)
          && validEmailPref(request.resource.data)
        )
        // A Head decides a staff sign-up: approving gives the role it asked
        // for and activates it, declining only marks it. Nothing else about
        // the profile may change.
        || (
          isHead()
          && resource.data.get('status', 'Active') == 'Pending'
          && resource.data.get('requestedRole', '') in ['Supervisor', 'Head']
          && resource.data.get('deleted', false) == false
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['role', 'status', 'requestedRole'])
          && (
            (
              request.resource.data.role == resource.data.requestedRole
              && request.resource.data.get('status', 'Active') == 'Active'
              && !('requestedRole' in request.resource.data)
            )
            || (
              request.resource.data.role == resource.data.role
              && request.resource.data.get('status', 'Active') == 'Declined'
              && unchanged('requestedRole')
            )
          )
        )
        || (
          isHead()
          && resource.data.get('status', 'Active') != 'Pending'
          && resource.data.role in ['Student', 'Student Assistant']
          && request.resource.data.role in ['Student', 'Student Assistant']
          && request.resource.data.get('status', 'Active')
            in ['Active', 'Archived']
          && request.resource.data.email == resource.data.email
          && resource.data.get('deleted', false) == false
          && sameOr('deleted', false)
          && unchanged('consentAt')
          && unchanged('consentVersion')
          && unchanged('emailNotifications')
        );

      // A registration that can't finish (its Student ID is taken) removes
      // the profile it just made. That's only possible before the email is
      // verified, i.e. before the account has ever been usable.
      allow delete: if isAdmin()
        || (
          authed()
          && request.auth.uid == uid
          && request.auth.token.email_verified != true
        );
    }

    // One document per Student ID, naming the account that holds it, so no
    // two accounts register the same ID. Registration reserves the ID on
    // the profile it has just saved — before the email is verified, hence
    // authed() — and only the Admin or Head can overwrite a reservation,
    // which is what keeps an ID with whoever registered it first. The Admin
    // and Head sessions also keep reservations in step with the profiles.
    match /studentIds/{studentId} {
      allow get: if authed();
      allow list: if isAdmin() || isHead();

      allow create: if isAdmin() || isHead()
        || (
          authed()
          && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid == request.auth.uid
          && exists(userPath(request.auth.uid))
          && string(
            get(userPath(request.auth.uid)).data.get('studentId', '')
          ).trim().upper() == studentId
        );

      allow update: if isAdmin() || isHead();

      // Undoing a registration frees the ID it reserved.
      allow delete: if isAdmin() || isHead()
        || (
          authed()
          && request.auth.token.email_verified != true
          && resource.data.uid == request.auth.uid
        );
    }

    match /students/{id} {
      // Admin reads these too now, to match Payroll records to students
      // whose account name and roster name differ.
      allow read: if isStaff() || isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      // Roster records change when the Head approves, rehires or releases
      // a student assistant. Supervisors never edit the roster.
      allow create, update, delete: if isHead();
    }

    // The Head posts hiring calls and notices, and approves or rejects the
    // Supervisors' requests. A Supervisor may only file a request in their
    // own name, Pending and closed: what decides whether a call takes
    // applications (isOpenHiringCall below) is the Head's approval, so a
    // Supervisor must never be able to write it, or to change a request's
    // owner or role. Until a request is decided they may withdraw it.
    match /announcements/{id} {
      allow read: if signedIn();

      allow create: if isHead()
        || (
          isSupervisor()
          && request.resource.data.get('postedById', null) == request.auth.uid
          && request.resource.data.get('postedByRole', null) == 'Supervisor'
          && request.resource.data.get('approvalStatus', null) == 'Pending'
          && request.resource.data.get('isOpen', null) == false
        );

      allow update: if isHead()
        || (
          isOwnPendingRequest()
          && unchanged('postedById')
          && unchanged('postedByRole')
          && unchanged('approvalStatus')
          && unchanged('isOpen')
        );

      allow delete: if isHead() || isOwnPendingRequest();

      function isOwnPendingRequest() {
        return isSupervisor()
          && resource.data.get('postedById', null) == request.auth.uid
          && resource.data.get('postedByRole', null) == 'Supervisor'
          && resource.data.get('approvalStatus', null) == 'Pending';
      }
    }

    // Applications & Applicant Screening are Head-exclusive now.
    match /applications/{id} {
      allow read: if isHead()
        || (
          signedIn()
          && resource.data.applicantId == request.auth.uid
        );

      // A new application is always Pending, under the applicant's own
      // name, from a Student account (an assistant, a Supervisor or the
      // Admin can't apply). Only the Head decides it. A student applies to be a Student
      // Assistant once a year, for the year in effect: the id names them
      // and the year (app_<uid>_<year>), so a second one is an update,
      // which they can't make. It goes through an open hiring call of the
      // Head's (its deadline is the app's to check: it's text).
      allow create: if isNewApplication() || isHeadYearMove();

      // One the Head rejected (a wrong document, say) the student may
      // replace with a new one, as if applying for the first time.
      allow update: if isHead()
        || (
          signedIn()
          && resource.data.applicantId == request.auth.uid
          && resource.data.get('status', '') == 'Rejected'
          && isNewApplication()
        );
      allow delete: if isHead();

      function isNewApplication() {
        return signedIn()
          && userExists()
          && currentRole() == 'Student'
          && request.resource.data.applicantId == request.auth.uid
          && id == 'app_' + request.auth.uid + '_'
            + request.resource.data.academicYear
          && isCurrentYear(request.resource.data.academicYear)
          && isOpenHiringCall(request.resource.data.announcementId)
          && request.resource.data.get('status', 'Pending') == 'Pending'
          && request.resource.data.get('remarks', null) == null
          && request.resource.data.applicantName == currentName()
          && applicationsOpen()
          && validClassSchedule(
            request.resource.data.get('classSchedule', null),
            request.auth.uid
          )
          // Only the Head marks the Student ID as checked.
          && request.resource.data.get('studentIdCheckedBy', null) == null
          && request.resource.data.get('studentIdCheckedAt', null) == null
          && validStudentNumber(request.resource.data.get('studentNumber', null))
          && validApplicationForm(request.resource.data.get('applicationForm', null));
      }

      // The Head moving an application out of the year the Admin undid, to
      // the year in effect (restampAcademicYear in the app): an unchanged
      // copy of the same applicant's application, whose old document goes
      // in the same batch. The Head can't invent or alter one this way.
      function isHeadYearMove() {
        let fromId = request.resource.data.get('movedFrom', '');
        return isHead() && fromId is string && fromId != '' && fromId != id
          ? headMovesApplication(fromId)
          : false;
      }

      function headMovesApplication(fromId) {
        let from = /databases/$(database)/documents/applications/$(fromId);
        let undone = exists(academicSettings())
          ? get(academicSettings()).data.get('undoneAcademicYear', '')
          : '';
        return undone is string && undone != ''
          && exists(from)
          && get(from).data.get('academicYear', '') == undone
          && fromId == 'app_' + get(from).data.get('applicantId', '') + '_'
            + undone
          && id == 'app_' + get(from).data.get('applicantId', '') + '_'
            + request.resource.data.get('academicYear', '')
          && isCurrentYear(request.resource.data.academicYear)
          && request.resource.data.diff(get(from).data).affectedKeys()
            .hasOnly(['academicYear', 'movedFrom'])
          && !existsAfter(from);
      }

      // The Student ID typed on an application (an older app build sends
      // none): the 23B0626 shape, and the profile's own when the profile
      // already holds one in that shape (an older one in another shape may
      // be corrected here; the Head checks it against the photo).
      function validStudentNumber(number) {
        let saved = string(currentUser().get('studentId', '')).trim().upper();
        return number == null
          || (
            number is string
            && number.matches('^[0-9]{2}[A-Z][0-9]{4}$')
            && (!saved.matches('^[0-9]{2}[A-Z][0-9]{4}$') || number == saved)
          );
      }

      // Structured responses for the official MarSU Application Form.
      // Bounded in size so an applicant cannot pack oversized arrays.
      function validApplicationForm(form) {
        return form == null
          || (
            form is map
            && form.size() <= 45
            && form.get('siblings', []) is list
            && form.get('siblings', []).size() <= 20
            && form.get('organizations', []) is list
            && form.get('organizations', []).size() <= 20
          );
      }

      // The class schedule sent with an application (the app asks for it;
      // an older app build sends none): its file in the applicant's own
      // schedules/ folder, and a bounded list of classes.
      function validClassSchedule(schedule, uid) {
        return schedule == null
          || (
            schedule is map
            && schedule.keys().hasOnly(['fileName', 'filePath', 'subjects'])
            && schedule.get('filePath', '') is string
            && schedule.get('filePath', '')
              .matches('schedules/' + uid + '/[^/]+/[^/]+')
            && schedule.get('subjects', []) is list
            && schedule.get('subjects', []).size() <= 60
          );
      }

      function academicSettings() {
        return /databases/$(database)/documents/meta/academic_year_settings;
      }

      // The Admin's "Open Applications" setting for the academic year. Like
      // the app, a setting that was never saved counts as open.
      function applicationsOpen() {
        return exists(academicSettings())
          ? get(academicSettings()).data.get('allowApplications', true) == true
          : true;
      }

      // The year the Admin set, when one was ever saved.
      function isCurrentYear(year) {
        return !exists(academicSettings())
          || get(academicSettings()).data.get('academicYear', year) == year;
      }

      // An approved, open announcement of the Head's that takes
      // applications, not a supervisor's request.
      function isOpenHiringCall(callId) {
        let call = /databases/$(database)/documents/announcements/$(callId);
        return callId is string && callId != '' && exists(call)
          && get(call).data.get('postedByRole', 'Admin') != 'Supervisor'
          && get(call).data.get('acceptsApplications', true) == true
          && get(call).data.get('isOpen', true) == true
          && get(call).data.get('approvalStatus', 'Approved') == 'Approved';
      }
    }

    // Reports feed the Supervisor's DTR/Accomplishment Report approval flow.
    // Head still reads all reports (used for org-wide hours totals) but
    // doesn't approve/edit/delete individual reports through the UI.
    match /reports/{id} {
      // Admin reads these too now, to verify accomplishment reports before
      // processing Payroll.
      allow read: if isHead() || isSupervisor() || isAdmin()
        || (
          signedIn()
          && resource.data.applicantId == request.auth.uid
        );

      // A report arrives Pending, under its author's own name, with nothing
      // a supervisor adds. Payroll treats an Approved report as sign-off, so
      // only the student's supervisor may approve it.
      allow create: if signedIn()
        && request.resource.data.applicantId == request.auth.uid
        && request.resource.data.status == 'Pending'
        && request.resource.data.studentName == currentName()
        && request.resource.data.get('feedback', null) == null
        && request.resource.data.get('reviewedBy', null) == null
        && request.resource.data.get('reviewedAt', null) == null
        && request.resource.data.get('sentToHead', false) == false
        && request.resource.data.get('sentToHeadAt', null) == null
        && request.resource.data.get('headAttachments', []).size() == 0;

      allow update: if (
          isSupervisorOf(resource.data.applicantId)
          && unchanged('applicantId')
        )
        || headMovesAcademicYear();

      allow delete: if isSupervisorOf(resource.data.applicantId);
    }

    match /attendance/{id} {
      // Admin reads these too now, to retrieve and verify DTR records
      // before processing Payroll.
      allow read: if isStaff() || isAdmin()
        || (
          signedIn()
          && resource.data.studentId == request.auth.uid
        );

      // Students never write here. They clock in and out through the
      // clock-attendance Supabase Edge Function, which validates the scanned
      // QR against the current session on the server and writes with a
      // Firebase service account. Leaving this staff-only is what stops a
      // student from calling the API directly and forging their own hours.
      // A Supervisor is further limited to their own office's students.
      //
      // Hours on a record are blank (still clocked in) or between 0 and 12:
      // a session is at most 4.5 hours, a corrected time-out a little more,
      // and nothing a person types in should credit a day and a half. (The
      // weekly cap itself can't be a rule: it adds up many records. The
      // app and clock-attendance both apply it.)
      allow create: if (
          isHead()
          || isSupervisorOf(request.resource.data.studentId)
        )
        && validHours();

      allow update: if (
          isHead()
          || (
            isSupervisorOf(resource.data.studentId)
            && unchanged('studentId')
          )
        )
        && validHours();

      allow delete: if isHead() || isSupervisorOf(resource.data.studentId);

      function validHours() {
        let hours = request.resource.data.get('totalHours', null);
        let before = request.resource.data.get('hoursBeforeWeeklyCap', null);
        return (hours == null || (hours is number && hours >= 0 && hours <= 12))
          && (before == null
            || (before is number && before >= 0 && before <= 24));
      }
    }

    match /tasks/{id} {
      function isTaskOwner(task) {
        return task.get('assignedTo', null) == request.auth.uid
          || (
            task.get('assignedTo', null) != null
            && exists(
              /databases/$(database)/documents/students/$(task.assignedTo)
            )
            && get(
              /databases/$(database)/documents/students/$(task.assignedTo)
            ).data.get('userId', '') == request.auth.uid
          );
      }

      allow read: if isStaff()
        || (signedIn() && isTaskOwner(resource.data));

      // A Supervisor may create, change or remove tasks for their own
      // office's students (or tasks not assigned to anyone yet).
      function supervisorMayHandle(task) {
        return task.get('assignedTo', null) == null
          ? isSupervisor()
          : isSupervisorOfStudent(task.assignedTo);
      }

      allow create: if isHead()
        ? true
        : (
          isSupervisor()
            ? supervisorMayHandle(request.resource.data)
            : isDutyLog()
        );

      // The task a Student Assistant makes to log a day of an ongoing duty
      // (see taskDuties): their own, active duty for this academic year;
      // today, Philippine time, and an attendance record of theirs from
      // today, so only a day they clocked in can be logged; one per duty
      // per day, since the id is made from both (a second write is an
      // update, which studentTaskUpdate lets change only the note). It
      // starts out Completed and waiting for the supervisor, the same as a
      // task the student completes, and says nothing the duty doesn't.
      function isDutyLog() {
        let d = request.resource.data;
        return isStudentAssistant()
          && currentUser().get('status', 'Active') == 'Active'
          && d.keys().hasOnly([
            'title', 'description', 'status', 'priority', 'dueDate',
            'assignedTo', 'assignedToName', 'assignedBy', 'category',
            'checklistItems', 'isArchived', 'academicYear', 'completedAt',
            'reviewStatus', 'dutyId', 'attendanceId', 'workDate', 'createdAt'
          ])
          && d.get('dutyId', '') is string
          && d.get('dutyId', '') != ''
          && d.get('attendanceId', '') is string
          && d.get('attendanceId', '') != ''
          && isDutyNote(d.get('description', null))
          && d.get('checklistItems', null) == []
          && exists(taskDutyPath(d.dutyId))
          && exists(attendancePath(d.attendanceId))
          && dutyLogMatches(
            d,
            get(taskDutyPath(d.dutyId)).data,
            get(attendancePath(d.attendanceId)).data
          );
      }

      // What the student wrote about the day: text of a sensible length.
      function isDutyNote(note) {
        return note is string && note.size() <= 300;
      }

      function taskDutyPath(dutyId) {
        return /databases/$(database)/documents/taskDuties/$(dutyId);
      }

      function attendancePath(attendanceId) {
        return /databases/$(database)/documents/attendance/$(attendanceId);
      }

      function dutyLogMatches(d, duty, attendance) {
        return duty.get('active', false) == true
          && duty.assignedTo == request.auth.uid
          && isCurrentAcademicYear(duty.get('academicYear', ''))
          && d.assignedTo == request.auth.uid
          && d.assignedToName == currentName()
          && d.assignedBy == duty.assignedBy
          && d.title == duty.title
          && d.priority == duty.priority
          && d.category == duty.category
          && d.academicYear == duty.academicYear
          && d.status == 'Completed'
          && d.reviewStatus == 'Pending'
          && d.get('isArchived', false) == false
          && d.completedAt == phDate(0)
          && d.workDate == phDate(0)
          && d.dueDate == phDate(0)
          && d.createdAt == request.time
          && id == 'dutylog_' + d.dutyId + '_' + phDayKey()
          && attendance.get('studentId', '') == request.auth.uid
          && attendance.get('date', '') == phDate(0)
          && attendance.get('isArchived', false) == false;
      }

      // The year the Admin set, when one was ever saved.
      function isCurrentAcademicYear(year) {
        return year != ''
          && (
            !exists(
              /databases/$(database)/documents/meta/academic_year_settings
            )
            || get(
              /databases/$(database)/documents/meta/academic_year_settings
            ).data.get('academicYear', year) == year
          );
      }

      // Ternaries, not ||, so only the requester's own case is evaluated —
      // see "Supervisor office scope" above.
      allow update: if isHead()
        ? true
        : (
          isSupervisor()
            ? supervisorMayHandle(resource.data)
              && supervisorMayHandle(request.resource.data)
            : (
              signedIn() && isTaskOwner(resource.data)
                ? studentTaskUpdate()
                : false
            )
        );

      allow delete: if isHead()
        || supervisorMayHandle(resource.data);

      // The student a task is assigned to may only move it through its
      // statuses. The completion date feeds their DTR, so it can only be
      // set to today (a day's slack either way for clocks and midnight).
      // Defaults mirror Task.fromJson, so older documents missing a field
      // still compare equal after the app rewrites them.
      function studentTaskUpdate() {
        return studentTaskReview()
          && request.resource.data.get('status', '')
            in ['Not Started', 'In Progress', 'Completed']
          && sameOr('title', '')
          && (
            sameOr('description', '')
            || (
              resource.data.get('dutyId', null) != null
              && isDutyNote(request.resource.data.get('description', null))
            )
          )
          && sameOr('priority', 'Medium')
          && sameOr('dueDate', '')
          && unchanged('assignedTo')
          && unchanged('assignedToName')
          && unchanged('assignedBy')
          && unchanged('category')
          && sameOr('checklistItems', [])
          && sameOr('isArchived', false)
          && unchanged('academicYear')
          && unchanged('dutyId')
          && unchanged('attendanceId')
          && unchanged('workDate')
          && (
            unchanged('completedAt')
            || request.resource.data.get('completedAt', null) == null
            || (
              request.resource.data.status == 'Completed'
              && (
                resource.data.get('dutyId', null) != null
                  // A duty log is for the day it names, whenever it is
                  // completed again.
                  ? request.resource.data.completedAt
                    == resource.data.get('workDate', 'none')
                  : request.resource.data.completedAt
                    in [phDate(-1), phDate(0), phDate(1)]
              )
            )
          );
      }

      // Only the supervisor approves or rejects a task. Once approved it
      // is on the student's DTR, so the student can't change it again.
      // Marking it Completed sends it for approval, with no verdict on it
      // (the app treats a completed task with no review as waiting, as
      // tasks completed before approvals existed are); taken back, it waits
      // for none, though a rejection may stay on it until it's completed
      // again.
      function studentTaskReview() {
        let after = request.resource.data;
        let reviewCleared = after.get('reviewedAt', null) == null
          && after.get('reviewedBy', null) == null
          && after.get('reviewNote', null) == null;
        return resource.data.get('reviewStatus', null) != 'Approved'
          && (
            after.get('status', '') == 'Completed'
              ? after.get('reviewStatus', null) in [null, 'Pending']
                && reviewCleared
              : (
                (after.get('reviewStatus', null) == null && reviewCleared)
                || (
                  after.get('reviewStatus', null) == 'Rejected'
                  && unchanged('reviewStatus')
                  && unchanged('reviewedAt')
                  && unchanged('reviewedBy')
                  && unchanged('reviewNote')
                )
              )
          );
      }
    }

    // Ongoing duties a Supervisor gives a Student Assistant (see Task
  // dutyId). The Supervisor sets them up for their own office's students and
  // stops them; the student reads their own and logs days through tasks.
    match /taskDuties/{id} {
      allow read: if isStaff()
        || (signedIn() && resource.data.assignedTo == request.auth.uid);

      allow create: if isHead()
        || (
          isSupervisor()
          && isSupervisorOfStudent(request.resource.data.assignedTo)
          && request.resource.data.assignedBy == request.auth.uid
        );

      allow update: if isHead()
        || (
          isSupervisor()
          && isSupervisorOfStudent(resource.data.assignedTo)
          && unchanged('assignedTo')
        );

      allow delete: if isHead()
        || (
          isSupervisor() && isSupervisorOfStudent(resource.data.assignedTo)
        );
    }

    match /classSchedules/{id} {
      allow read: if isStaff()
        || (
          signedIn()
          && resource.data.studentId == request.auth.uid
        );

      allow create: if isHead()
        || isSupervisorOfStudent(request.resource.data.studentId);

      allow update: if isHead()
        || (
          isSupervisorOfStudent(resource.data.studentId)
          && unchanged('studentId')
        );

      allow delete: if isHead()
        || isSupervisorOfStudent(resource.data.studentId);
    }

    // Notifications are private to the person they're for — they carry pay,
    // evaluation ratings and rejection remarks. The app only ever reads,
    // marks read or clears the signed-in user's own.
    match /notifications/{id} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;

      // Staff and the Admin (payroll, role changes) may notify anyone.
      // Anyone else may notify themselves, or send the Head or a Supervisor
      // one of the alerts the app raises for them — a new application, a
      // new report, a task's status changing — as plain text, with no
      // attachment link to lure them to.
      //
      // Whoever sends it, the text is short: a title of up to 100 and a
      // message of up to 500 characters (the app cuts longer ones).
      allow create: if id.matches('^[A-Za-z0-9_.:-]{1,128}$')
        && (
          isStaff() || isAdmin()
          || (
            signedIn()
            && request.resource.data.userId == request.auth.uid
          )
          || (
            signedIn()
            && request.resource.data.type
              in ['application', 'report', 'task', 'schedule']
            && request.resource.data.get('attachmentUrl', null) == null
            && request.resource.data.get('attachmentName', null) == null
            && request.resource.data.get('isRead', false) == false
            && isStaffAccount(request.resource.data.userId)
          )
        )
        && shortText(request.resource.data.get('title', ''), 100)
        && shortText(request.resource.data.get('message', ''), 500);

      function shortText(value, max) {
        return value is string && value.size() <= max;
      }

      // Marking read is the only change the app makes.
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isRead']);

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // The browsers each user gets push notifications on (clock-out
    // reminders), one per Firebase Cloud Messaging token. The
    // clockout-reminders function reads them with a service account; the
    // app only saves and removes its own. Signing in on a browser another
    // account used takes its token over, so that browser stops getting the
    // other account's reminders.
    match /pushTokens/{token} {
      allow read, delete: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['userId', 'token', 'updatedAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.token == token
        && request.resource.data.updatedAt == request.time;
    }

    // The name and picture of each Supervisor, copied from their profile so a
    // Student Assistant can see who supervises their office on My Office
    // without being able to read the profile (email, phone, ...). A Supervisor
    // writes their own card; the Head and the Admin keep every card in step
    // from the profiles they can read.
    match /supervisorCards/{uid} {
      allow read: if signedIn();

      allow create, update: if signedIn()
        && request.resource.data.keys().hasAll(['name', 'avatar', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.avatar is string
        && request.resource.data.updatedAt == request.time
        && (isHead() || isAdmin()
          || (request.auth.uid == uid && isSupervisor()));

      allow delete: if isHead() || isAdmin();
    }

    // Offices decide which students each Supervisor may change, so only the
    // Head (who runs the Offices screen) edits them.
    match /offices/{id} {
      allow read: if signedIn();
      allow write: if isHead();
    }

    // Which office each student assistant is in, mirrored from the offices
    // by the Head's session so the rules above can find it.
    match /officeAssignments/{uid} {
      allow read, write: if isHead();
    }

    // Departments & Settings stay Admin-exclusive. Departments and the
    // programs under them are readable without an account: the
    // registration form lists them before the visitor has signed in.
    match /departments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /programs/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(
          ['code', 'name', 'department', 'createdAt', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // Skills screen is Head-exclusive now.
    match /skills/{id} {
      allow read: if signedIn();
      allow write: if isHead();
    }

    // Performance Evaluation screen is Supervisor-exclusive. The Head reads
    // evaluations for the Rehiring screen, which follows up on each one's
    // "Eligible for Rehire" mark, but never edits them.
    match /evaluations/{id} {
      allow read: if isSupervisor() || isHead();

      allow create: if isSupervisorOfStudent(request.resource.data.studentId);

      allow update: if (
          isSupervisorOfStudent(resource.data.studentId)
          && unchanged('studentId')
        )
        || headMovesAcademicYear();

      allow delete: if isSupervisorOfStudent(resource.data.studentId);
    }

    // The Head's rehire decisions, one per student per term.
    match /rehireRecords/{id} {
      allow read, write: if isHead();
    }

    // Items a Supervisor forwards to the Head (reports, evaluations, DTR
    // reports) for the Head's dedicated "Sent to Head" screen. Supervisor
    // creates them; Head can read and toggle "reviewed".
    match /headForwards/{id} {
      allow read: if isHead() || isSupervisor();
      allow create: if isSupervisor()
        && request.resource.data.get('sentById', null) == request.auth.uid
        && request.resource.data.get('reviewed', false) == false
        && (
          request.resource.data.get('studentId', '') == ''
          || isSupervisorOfStudent(request.resource.data.studentId)
        );
      allow update: if isHead()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewed']);
      allow delete: if isHead();
    }

    // Payroll: an Admin initiates processing; each record is also readable
    // by the Student Assistant it was paid to.
    match /payrollRecords/{id} {
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.studentId == request.auth.uid
        );
      allow create, update, delete: if isAdmin();
    }

    // The Admin's editable copy of the printed Hourly Wage Payroll.
    match /payrollSheets/{id} {
      allow read, write: if isAdmin();
    }

    // The Head's check of each Student Assistant's payroll requirements,
    // one document per student (their account id). The Admin reads it to
    // see whether a term's payroll can be approved.
    match /payrollChecks/{studentId} {
      // A Student Assistant reads their own, to see what the Head returned.
      allow read: if isHead() || isAdmin()
        || (signedIn() && request.auth.uid == studentId);
      allow create, update: if isHead()
        && request.resource.data.keys().hasOnly(
          ['studentId', 'studentName', 'items', 'exclusions', 'updatedAt']
        )
        && request.resource.data.studentId == studentId
        && request.resource.data.get('items', {}) is map
        && request.resource.data.get('exclusions', {}) is map;
      allow delete: if isHead();
    }

    // Applicant Screening is Head-exclusive.
    match /screeningRecords/{id} {
      allow read, write: if isHead();
    }

    match /documents/{id} {
      allow read, write: if isStaff();
    }

    // Document Folders is the Head's free-form file manager for uploads
    // that aren't tied to an application/report/evaluation.
    match /documentFolders/{id} {
      allow read, write: if isHead();
    }

    // ── Schedules ───────────────────────────────────────────────────────
    // Weekly schedules and calendar events say where someone is and when.
    // Each belongs to one account (ownerId). The Head, the owner, and the
    // Supervisor of the owner's office may see and change it — the owner
    // only if they are a Student Assistant or Supervisor, the roles with a
    // Schedule screen. Schedules saved before accounts were recorded have
    // no ownerId and stay Head-only until the Head's session moves them
    // across.

    function maySeeSchedule(ownerId) {
      return isHead()
        || (signedIn() && ownerId != '' && ownerId == request.auth.uid)
        || isSupervisorOf(ownerId);
    }

    function mayChangeSchedule(ownerId) {
      return isHead()
        || (
          ownerId != ''
          && ownerId == request.auth.uid
          && (isStudentAssistant() || isSupervisor())
        )
        || isSupervisorOf(ownerId);
    }

    // One document per owner, keyed by their account id. Beside the weekly
    // rules it keeps the approved class schedules (`classSchedules`): only
    // a Head writes those (approving a schedule, or changing the classes),
    // so a Student Assistant or Supervisor may save the rest of the
    // document but never touch them, and can't delete a document that has
    // them.
    match /recurringSchedules/{ownerId} {
      allow read: if maySeeSchedule(ownerId);
      allow create: if mayChangeSchedule(ownerId)
        && request.resource.data.get('ownerId', '') == ownerId
        && (isHead() || !('classSchedules' in request.resource.data));
      allow update: if mayChangeSchedule(ownerId)
        && request.resource.data.get('ownerId', '') == ownerId
        && (
          isHead()
          || !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['classSchedules'])
        );
      allow delete: if isHead()
        || (
          mayChangeSchedule(ownerId)
          && !('classSchedules' in resource.data)
        );
    }

    // A Student Assistant's new class schedule, waiting for the Head. They
    // send it for themselves only, Pending, stamped with the server's time,
    // its file in their own schedules/ folder; they may withdraw it while
    // it waits. Only the Head decides it, and only while it waits, without
    // changing what was sent. Nobody deletes one.
    match /scheduleRequests/{id} {
      allow read: if isHead()
        || (signedIn() && resource.data.studentId == request.auth.uid);

      allow create: if signedIn()
        && isStudentAssistant()
        && request.resource.data.studentId == request.auth.uid
        && id.matches(request.auth.uid + '_[0-9]+')
        && request.resource.data.id == id
        && request.resource.data.studentName == currentName()
        && request.resource.data.status == 'Pending'
        && request.resource.data.submittedAt == request.time
        && request.resource.data.keys().hasOnly([
          'id', 'studentId', 'studentName', 'academicYear', 'fileName',
          'filePath', 'subjects', 'effectiveFrom', 'note', 'status',
          'submittedAt'
        ])
        && request.resource.data.filePath is string
        && request.resource.data.filePath
          .matches('schedules/' + request.auth.uid + '/[^/]+/[^/]+')
        && request.resource.data.subjects is list
        && request.resource.data.subjects.size() > 0
        && request.resource.data.subjects.size() <= 60
        && request.resource.data.get('note', '') is string
        && request.resource.data.get('note', '').size() <= 300
        && request.resource.data.effectiveFrom is string
        && request.resource.data.effectiveFrom.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');

      allow update: if resource.data.status == 'Pending'
        && (
          (
            isHead()
            && request.resource.data.status in ['Approved', 'Rejected']
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'reviewNote', 'reviewedBy', 'reviewedAt'])
          )
          || (
            signedIn()
            && resource.data.studentId == request.auth.uid
            && request.resource.data.status == 'Cancelled'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status'])
          )
        );

      allow delete: if false;
    }

    match /schedule_events/{id} {
      allow read: if maySeeSchedule(resource.data.get('ownerId', ''));
      allow create: if mayChangeSchedule(
        request.resource.data.get('ownerId', '')
      );
      allow update: if mayChangeSchedule(resource.data.get('ownerId', ''))
        && mayChangeSchedule(request.resource.data.get('ownerId', ''));
      allow delete: if mayChangeSchedule(resource.data.get('ownerId', ''));
    }

    // Each office's attendance code for the session running now, one
    // document per office. Only that office's own supervisors may read or
    // post it: anyone else who could read it could clock in without being
    // there. Students' scans are checked against it on the server, by the
    // clock-attendance function, which reads it with its own access and
    // accepts only the code of an office the student is in.
    //
    // A session's code is saved once and then stays put, so a printed copy
    // keeps working all session: an update must start a new session.
    // The read must not look at `resource`, so the generator's transaction
    // can read a document that doesn't exist yet.
    match /attendanceQr/{officeId} {
      allow read: if supervisorHeadsOffice(officeId);
      allow create: if supervisorHeadsOffice(officeId) && validAttendanceQr();
      allow update: if supervisorHeadsOffice(officeId) && validAttendanceQr()
        && resource.data.get('sessionKey', '')
          != request.resource.data.sessionKey;
    }

    function validAttendanceQr() {
      let d = request.resource.data;
      let keys = ['token', 'sessionKey', 'generatedAt', 'officeName'];
      return d.keys().hasOnly(keys) && d.keys().hasAll(keys)
        && d.token is string && d.token.size() >= 40 && d.token.size() <= 200
        && d.sessionKey is string
        && d.sessionKey.matches('^[0-9]{8}-(AM|PM)$')
        && d.officeName is string && d.officeName.size() <= 200
        && d.generatedAt == request.time;
    }

    match /meta/academic_year_settings {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // The task categories and the ready-made task templates under them are
    // the Head's to manage; everyone signed in reads them (the Supervisor
    // picks from them when assigning a task).
    match /meta/task_categories {
      allow read: if signedIn();
      allow write: if isHead();
    }

    match /meta/task_templates {
      allow read: if signedIn();
      allow write: if isHead();
    }

    // Every other meta document. Firestore allows a request if any matching
    // rule does, and this one matches the documents above too — so it must
    // leave them out: its staff write would let a Head or Supervisor change
    // Admin-only settings. `current_qr` is the old school-wide attendance
    // code, replaced by attendanceQr above: nobody reads or writes it now.
    match /meta/{document} {
      allow read: if signedIn() && !(document in ['current_qr', 'saCounter']);
      allow write: if isStaff()
        && !(document in [
          'academic_year_settings', 'task_categories', 'task_templates',
          'heads', 'saCounter', 'current_qr'
        ]);
    }

    // The next Student Assistant number ("SA 007"). The Head's session takes
    // it in a transaction when it approves someone, so it is the Head's alone:
    // a Supervisor writing it could hand out numbers twice.
    match /meta/saCounter {
      allow read, write: if isHead();
    }

    // Who the Heads are, so students' alerts (a new application, say) reach
    // them. A Head's or the Admin's session keeps it in step with the
    // roster; a Supervisor must not be able to point alerts elsewhere.
    match /meta/heads {
      allow read: if signedIn();
      allow write: if isHead() || isAdmin();
    }

    // Finished academic years: one summary per year, which the Reports
    // screen offers everyone as a filter. The Admin records a year when
    // moving the settings on, and removes it again when undoing that; the
    // Head's session records one whose end date has passed and copies each
    // year's records into it — only the Head can read them all.
    match /meta/academic_year_archives/years/{year} {
      allow read: if signedIn();
      allow write: if isAdmin() || isHead();
    }

    match /meta/academic_year_archives/years/{year}/{collection}/{id} {
      allow read: if isHead() || isAdmin();
      allow write: if isHead();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
